    {
      "name": "Sessions — consulta y salida",
      "item": [
        {
          "name": "⚠ GET /sessions/{{ticketCode}} — requiere calculateAmount()",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 500) {",
                  "  pm.test('PENDIENTE: calculateAmount() sin implementar', () => {",
                  "    pm.expect.fail('500 — implementa src/common/calculate-amount.ts');",
                  "  });",
                  "} else {",
                  "  pm.test('200', () => pm.response.to.have.status(200));",
                  "  const body = pm.response.json();",
                  "  pm.test('la placa vuelve normalizada', () => {",
                  "    pm.expect(body.plate).to.match(/^[A-Z0-9]+$/);",
                  "  });",
                  "  pm.test('status es active', () => pm.expect(body.status).to.eql('active'));",
                  "  pm.test('amountDue es numero', () => pm.expect(body.amountDue).to.be.a('number'));",
                  "  pm.test('minutesElapsed es numero', () => pm.expect(body.minutesElapsed).to.be.a('number'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{ticketCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{ticketCode}}"]
            }
          }
        },
