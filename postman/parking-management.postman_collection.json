                  "const body = pm.response.json();",
                  "pm.test('capacity 7, occupied 3', () => {",
                  "  pm.expect(body.capacity).to.eql(7);",
                  "  pm.expect(body.occupied).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lots/2/availability",
              "host": ["{{baseUrl}}"],
              "path": ["lots", "2", "availability"]
