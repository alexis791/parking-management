    {
      "name": "Sessions — alta",
      "item": [
        {
          "name": "POST /sessions — alta con placa sucia",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Placa aleatoria para que la coleccion sea re-ejecutable.",
                  "// Se manda sucia a proposito: minusculas, guion y espacio.",
                  "const n = Math.floor(1000 + Math.random() * 9000);",
                  "pm.collectionVariables.set('plate', `tst-${n} 00`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve ticketCode con formato T-AAAA-NNNN', () => {",
                  "  pm.expect(body.ticketCode).to.match(/^T-\\d{4}-\\d{4}$/);",
                  "});",
                  "pm.test('devuelve lotName, no lotId', () => {",
                  "  pm.expect(body.lotName).to.eql('Edificio Norte');",
                  "  pm.expect(body).to.not.have.property('id');",
                  "});",
                  "pm.test('entryTime es una fecha valida', () => {",
                  "  pm.expect(new Date(body.entryTime).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "",
                  "pm.collectionVariables.set('ticketCode', body.ticketCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lotId\": 1,\n  \"plate\": \"{{plate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "POST /sessions — vehículo ya dentro → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
