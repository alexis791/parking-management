          "name": "POST /sessions/T-2026-0002/exit — salida desde 'paid'",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, no 201: no crea un recurso', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('queda closed', () => pm.expect(body.status).to.eql('closed'));",
                  "pm.test('no se cobra: ya habia pagado', () => pm.expect(body.amountCharged).to.eql(0));",
                  "pm.test('previouslyPaid distingue esto de la tolerancia', () => {",
                  "  pm.expect(body.previouslyPaid).to.eql(true);",
                  "});"
                ]
              }
            }
