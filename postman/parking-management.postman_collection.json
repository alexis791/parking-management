                  "} else {",
                  "  pm.test('200', () => pm.response.to.have.status(200));",
                  "  const body = pm.response.json();",
                  "  pm.test('queda closed', () => pm.expect(body.status).to.eql('closed'));",
                  "  pm.test('no habia pagado antes', () => pm.expect(body.previouslyPaid).to.eql(false));",
                  "  pm.test('amountCharged es numero', () => pm.expect(body.amountCharged).to.be.a('number'));",
                  "  pm.test('exitTime no es anterior a entryTime', () => {",
                  "    pm.expect(new Date(body.exitTime) >= new Date(body.entryTime)).to.be.true;",
